<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <NukeRootDirectory>..</NukeRootDirectory>
    <NukeScriptDirectory>..</NukeScriptDirectory>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
    <NoWarn>$(NoWarn);NU1901;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Forces the app-local assemblies to match the version the 10.0.400 SDK expects -->
    <PackageReference Include="NuGet.Frameworks" Version="7.9.0" />
    <PackageReference Include="Microsoft.Build" Version="18.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin to version 4.8.13 for free method level coverage -->
    <PackageDownload Include="ReportGenerator" Version="[4.8.13]" />
    <!--<PackageDownload Include="ReportGenerator" Version="[5.5.11]" />-->
  </ItemGroup>

</Project>