<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <AssemblyName>GraduatedCylinder.Tests</AssemblyName>
    <RootNamespace>GraduatedCylinder</RootNamespace>
    <DefineConstants>$(DefineConstants);GraduatedCylinder</DefineConstants>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\GraduatedCylinder\GraduatedCylinder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="GraduatedCylinder.Tests.csproj.DotSettings" Visible="false" />
  </ItemGroup>

</Project>
